/* =========================
   GLOBAL DESIGN
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary: #2563eb;
    --primary-dark: #1e40af;
    --background: #f5f7fb;
    --white: #ffffff;
    --text: #172033;
    --muted: #718096;
    --border: #e5eaf2;
}

body {
    font-family: "Segoe UI", Arial, sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.6;
}

a {
    text-decoration: none;
    color: inherit;
}

button {
    font-family: inherit;
    cursor: pointer;
}

/* =========================
   MAIN LAYOUT
========================= */

.layout {
    display: flex;
    min-height: 100vh;
}

/* =========================
   SIDEBAR
========================= */

.sidebar {
    width: 250px;
    background: #ffffff;
    border-right: 1px solid var(--border);
    padding: 28px 18px;
    position: fixed;
    height: 100vh;
    overflow-y: auto;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 40px;
    padding-left: 8px;
}

.logo-icon {
    background: var(--primary);
    color: white;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    font-size: 22px;
    font-weight: bold;
}

.logo h2 {
    font-size: 20px;
    font-weight: 750;
}

.logo span {
    color: var(--primary);
}

.nav-title {
    font-size: 11px;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 1.3px;
    margin: 24px 12px 12px;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    margin-bottom: 5px;
    border-radius: 9px;
    color: #64748b;
    font-size: 14px;
    font-weight: 500;
    transition: 0.2s;
}

.nav-link:hover,
.nav-link.active {
    background: #eff6ff;
    color: var(--primary);
}

.nav-icon {
    width: 22px;
    text-align: center;
    font-size: 17px;
}

.sidebar-bottom {
    margin-top: 45px;
    padding: 18px;
    background: #eff6ff;
    border-radius: 12px;
}

.sidebar-bottom h4 {
    font-size: 14px;
    margin-bottom: 7px;
}

.sidebar-bottom p {
    font-size: 12px;
    color: #64748b;
    margin-bottom: 12px;
}

.sidebar-bottom a {
    color: var(--primary);
    font-size: 13px;
    font-weight: 600;
}

/* =========================
   MAIN CONTENT
========================= */

.main {
    margin-left: 250px;
    width: calc(100% - 250px);
    padding: 28px 40px;
}

/* =========================
   TOP BAR
========================= */

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 35px;
}

.breadcrumb {
    font-size: 13px;
    color: var(--muted);
}

.breadcrumb span {
    color: var(--text);
    font-weight: 600;
}

.top-right {
    display: flex;
    align-items: center;
    gap: 15px;
}

.search-box {
    display: flex;
    align-items: center;
    gap: 10px;
    background: white;
    border: 1px solid var(--border);
    padding: 10px 14px;
    border-radius: 10px;
    width: 260px;
}

.search-box input {
    border: none;
    outline: none;
    width: 100%;
    font-size: 13px;
    background: transparent;
}

.profile {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #dbeafe;
    color: #1d4ed8;
    display: grid;
    place-items: center;
    font-weight: 700;
}

/* =========================
   HERO SECTION
========================= */

.hero {
    background: linear-gradient(120deg, #1d4ed8, #2563eb, #3b82f6);
    border-radius: 20px;
    padding: 42px;
    color: white;
    position: relative;
    overflow: hidden;
    margin-bottom: 32px;
}

.hero::after {
    content: "";
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
    right: -70px;
    top: -100px;
}

.hero-content {
    position: relative;
    z-index: 1;
    max-width: 650px;
}

.hero-label {
    display: inline-block;
    background: rgba(255,255,255,0.15);
    padding: 6px 12px;
    border-radius: 30px;
    font-size: 12px;
    margin-bottom: 18px;
}

.hero h1 {
    font-size: 36px;
    line-height: 1.25;
    margin-bottom: 15px;
    font-weight: 750;
}

.hero p {
    color: #dbeafe;
    font-size: 15px;
    max-width: 560px;
    margin-bottom: 25px;
}

.hero-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    border-radius: 9px;
    border: none;
    font-size: 13px;
    font-weight: 650;
    transition: 0.2s;
}

.btn-white {
    background: white;
    color: #1d4ed8;
}

.btn-white:hover {
    background: #eff6ff;
}

.btn-outline {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.4);
    color: white;
}

.btn-outline:hover {
    background: rgba(255,255,255,0.1);
}

/* =========================
   STATISTICS
========================= */

.stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 35px;
}

.stat-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px;
    display: flex;
    align-items: center;
    gap: 16px;
}

.stat-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    font-size: 22px;
    background: #eff6ff;
}

.stat-card h3 {
    font-size: 23px;
    line-height: 1.3;
}

.stat-card p {
    font-size: 12px;
    color: var(--muted);
}

/* =========================
   SECTION HEADER
========================= */

.section {
    margin-bottom: 38px;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
}

.section-header h2 {
    font-size: 21px;
    font-weight: 750;
}

.section-header p {
    font-size: 12px;
    color: var(--muted);
}

.view-all {
    font-size: 13px;
    font-weight: 600;
    color: var(--primary);
}

/* =========================
   SUBJECT CARDS
========================= */

.subject-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}

.subject-card {
    background: white;
    border: 1px solid var(--border);
    padding: 22px;
    border-radius: 14px;
    transition: 0.25s;
}

.subject-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.06);
    border-color: #bfdbfe;
}

.subject-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    font-size: 22px;
    margin-bottom: 17px;
}

.blue {
    background: #eff6ff;
}

.purple {
    background: #f3e8ff;
}

.green {
    background: #dcfce7;
}

.orange {
    background: #ffedd5;
}

.subject-card h3 {
    font-size: 15px;
    margin-bottom: 6px;
}

.subject-card p {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 18px;
}

.subject-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 13px;
    border-top: 1px solid #f1f5f9;
}

.subject-footer span {
    font-size: 11px;
    color: #64748b;
}

.subject-footer a {
    color: var(--primary);
    font-size: 12px;
    font-weight: 650;
}

/* =========================
   NOTES SECTION
========================= */

.notes-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.note-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px;
    transition: 0.2s;
}

.note-card:hover {
    border-color: #bfdbfe;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
}

.note-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.file-icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #eff6ff;
    font-size: 20px;
}

.tag {
    font-size: 10px;
    font-weight: 700;
    color: #2563eb;
    background: #eff6ff;
    padding: 5px 9px;
    border-radius: 20px;
}

.note-card h3 {
    font-size: 15px;
    margin-bottom: 8px;
}

.note-card p {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 18px;
}

.note-bottom {
    border-top: 1px solid #f1f5f9;
    padding-top: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.note-bottom span {
    font-size: 11px;
    color: #64748b;
}

.download-btn {
    background: #eff6ff;
    color: var(--primary);
    border: none;
    padding: 8px 12px;
    border-radius: 7px;
    font-size: 11px;
    font-weight: 650;
}

.download-btn:hover {
    background: #dbeafe;
}

/* =========================
   EMPTY SEARCH MESSAGE
========================= */

.empty-message {
    display: none;
    background: white;
    padding: 25px;
    text-align: center;
    border-radius: 12px;
    color: var(--muted);
    font-size: 14px;
    margin-top: 15px;
}

/* =========================
   FOOTER
========================= */

.footer {
    border-top: 1px solid var(--border);
    margin-top: 50px;
    padding: 25px 0;
    display: flex;
    justify-content: space-between;
    gap: 15px;
    color: var(--muted);
    font-size: 12px;
}

/* =========================
   RESPONSIVE DESIGN
========================= */

@media (max-width: 1200px) {

    .subject-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .notes-list {
        grid-template-columns: repeat(2, 1fr);
    }

    .main {
        padding: 25px;
    }

