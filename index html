@media (max-width: 550px) {

    .main {
        padding: 18px 14px;
    }

    .topbar {
        flex-direction: column;
        align-items: flex-start;
    }

    .top-right {
        width: 100%;
    }

    .search-box {
        width: 100%;
    }

    .hero {
        padding: 28px 22px;
    }

    .hero h1 {
        font-size: 27px;
    }

    .hero p {
        font-size: 13px;
    }

    .subject-grid,
    .notes-list {
        grid-template-columns: 1fr;
    }

    .section-header h2 {
        font-size: 18px;
    }

    .footer {
        flex-direction: column;
    }

}

</style>
