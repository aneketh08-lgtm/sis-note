@media (max-width: 850px) {

    .sidebar {
        width: 75px;
        padding: 20px 10px;
    }

    .logo {
        justify-content: center;
        padding: 0;
    }

    .logo h2,
    .nav-title,
    .nav-link span,
    .sidebar-bottom {
        display: none;
    }

    .nav-link {
        justify-content: center;
        padding: 14px 5px;
    }

    .nav-icon {
